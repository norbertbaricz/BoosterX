<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <ControlsRoot Condition="'$(ControlsRoot)' == ''">$(MSBuildProjectDirectory)/../../Controls</ControlsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ControlsRoot)/*.cs" Link="Controls/%(Filename)%(Extension)" />
    <Compile Include="../../Services/ControlRenderingChecks.cs" Link="ControlRenderingChecks.cs" />
    <Compile Include="../../Services/InteractionChecks.cs" Link="InteractionChecks.cs" />
  </ItemGroup>
</Project>
